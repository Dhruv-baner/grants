{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Grants and Funding case record",
 "description": "One record per client or lead. Every tool reads and writes this object; it is the only hand-off between tools.",
 "type": "object",
 "required": ["case_id", "created_at", "company", "matches", "audit"],
 "properties": {
  "case_id": {"type": "string"},
  "created_at": {"type": "string"},
  "company": {"type": "object", "required": ["name", "country"],
   "properties": {"name": {"type": "string"}, "website": {"type": "string"}, "country": {"enum": ["NL", "DE", "EU", "OTHER"]},
    "region": {"type": "string"}, "size": {"enum": ["micro", "small", "medium", "large", "unknown"]},
    "sectors": {"type": "array", "items": {"type": "string"}}, "activities": {"type": "string"},
    "rd_signals": {"type": "array", "items": {"type": "string"}}, "planned_investments": {"type": "array", "items": {"type": "string"}},
    "profile_confidence": {"enum": ["high", "medium", "low"]}}},
  "matches": {"type": "array", "items": {"type": "object", "required": ["scheme_id", "fit", "reasons"],
   "properties": {"scheme_id": {"type": "string"}, "fit": {"enum": ["high", "medium", "low"]}, "score": {"type": "number"},
    "reasons": {"type": "array", "items": {"type": "string"}}, "blocking_issues": {"type": "array", "items": {"type": "string"}},
    "status_clean": {"type": "string"}, "next_deadline": {"type": "string"},
    "data_confidence": {"enum": ["Verified", "Verified (framework)", "Partial", "Candidate"]},
    "questions_for_consultant": {"type": "array", "items": {"type": "string"}}}}},
  "evidence": {"type": "object", "properties": {
    "documents": {"type": "array", "items": {"type": "object", "properties": {"name": {"type": "string"}, "kind": {"type": "string"}, "status": {"enum": ["received", "missing", "needs_review"]}}}},
    "gaps": {"type": "array", "items": {"type": "object", "properties": {"scheme_id": {"type": "string"}, "requirement": {"type": "string"}, "state": {"enum": ["met", "unmet", "unknown"]}}}}}},
  "notes": {"type": "string"},
  "audit": {"type": "object", "required": ["data_version", "data_as_of"],
   "properties": {"data_version": {"type": "string"}, "data_as_of": {"type": "string"}, "models_used": {"type": "array", "items": {"type": "string"}}, "cost_usd": {"type": "number"}}}
 }
}
