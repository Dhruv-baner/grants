{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Grants and Funding company profile",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "name",
  "country",
  "size",
  "sectors",
  "activities",
  "signals",
  "confidence"
 ],
 "properties": {
  "name": {
   "type": "string",
   "maxLength": 120
  },
  "website": {
   "type": "string",
   "maxLength": 300
  },
  "country": {
   "enum": [
    "NL",
    "DE",
    "EU",
    "OTHER"
   ]
  },
  "region": {
   "type": "string",
   "maxLength": 60
  },
  "size": {
   "enum": [
    "micro",
    "small",
    "medium",
    "large",
    "unknown"
   ]
  },
  "sectors": {
   "type": "array",
   "maxItems": 3,
   "items": {
    "enum": [
     "Energy & climate",
     "Industry & manufacturing",
     "Digital, AI & ICT",
     "Health & life sciences",
     "Agriculture & food",
     "Buildings & real estate",
     "Transport & maritime",
     "Circular economy & environment",
     "Creative, media & games",
     "Defence & security",
     "Education & skills",
     "Public sector & municipalities",
     "All sectors"
    ]
   }
  },
  "activities": {
   "type": "string",
   "maxLength": 400
  },
  "signals": {
   "type": "array",
   "maxItems": 8,
   "items": {
    "type": "string",
    "maxLength": 80
   }
  },
  "confidence": {
   "enum": [
    "high",
    "medium",
    "low"
   ]
  },
  "description": {
   "type": "string",
   "maxLength": 400
  }
 }
}