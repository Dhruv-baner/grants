{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Grants and Funding scheme or call row",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "id",
  "row_type",
  "name",
  "country",
  "verification",
  "status",
  "status_clean",
  "type_group",
  "sector",
  "sources",
  "as_of"
 ],
 "properties": {
  "id": {
   "type": "string"
  },
  "row_type": {
   "enum": [
    "scheme",
    "call"
   ]
  },
  "parent_id": {
   "type": "string"
  },
  "closes_on": {
   "type": "string"
  },
  "name": {
   "type": "string"
  },
  "summary": {
   "type": "string"
  },
  "ignite_listed": {
   "enum": [
    "Yes",
    "No"
   ]
  },
  "ignite_tags": {
   "type": "string"
  },
  "ignite_url": {
   "type": "string"
  },
  "aliases": {
   "type": "string"
  },
  "country": {
   "type": "string"
  },
  "level": {
   "type": "string"
  },
  "region": {
   "type": "string"
  },
  "type": {
   "type": "string"
  },
  "authority": {
   "type": "string"
  },
  "official_url": {
   "type": "string"
  },
  "legal_basis": {
   "type": "string"
  },
  "programme_period": {
   "type": "string"
  },
  "status": {
   "type": "string"
  },
  "status_note": {
   "type": "string"
  },
  "applicants": {
   "type": "string"
  },
  "size_rule": {
   "type": "string"
  },
  "consortium": {
   "type": "string"
  },
  "stage": {
   "type": "string"
  },
  "activities": {
   "type": "string"
  },
  "funding_rate": {
   "type": "string"
  },
  "caps": {
   "type": "string"
  },
  "budget": {
   "type": "string"
  },
  "instrument_detail": {
   "type": "string"
  },
  "state_aid": {
   "type": "string"
  },
  "stacking": {
   "type": "string"
  },
  "eligible_costs": {
   "type": "string"
  },
  "excluded_costs": {
   "type": "string"
  },
  "channel": {
   "type": "string"
  },
  "window": {
   "type": "string"
  },
  "before_start": {
   "type": "string"
  },
  "assessment": {
   "type": "string"
  },
  "success_stats": {
   "type": "string"
  },
  "decision_time": {
   "type": "string"
  },
  "per_period_limit": {
   "type": "string"
  },
  "post_award": {
   "type": "string"
  },
  "audit_risk": {
   "type": "string"
  },
  "fit_signals": {
   "type": "string"
  },
  "rejection_risks": {
   "type": "string"
  },
  "call_questions": {
   "type": "string"
  },
  "related": {
   "type": "string"
  },
  "verification": {
   "enum": [
    "Verified",
    "Verified (framework)",
    "Partial",
    "Candidate",
    "Listing only"
   ]
  },
  "as_of": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}(-\\d{2})?$"
  },
  "confidence": {
   "type": "string"
  },
  "sources": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "field",
     "url",
     "tier"
    ],
    "properties": {
     "field": {
      "type": "string"
     },
     "url": {
      "type": "string",
      "pattern": "^https?://\\S+$"
     },
     "tier": {
      "enum": [
       "Official",
       "Secondary",
       "Trade press"
      ]
     }
    }
   }
  },
  "conflicts": {
   "type": "string"
  },
  "open_questions": {
   "type": "string"
  },
  "type_group": {
   "enum": [
    "Equity",
    "Grant",
    "Guarantee",
    "Loan",
    "Mixed (grant and equity)",
    "Mixed (grant and loan)",
    "Other",
    "Other (commercial finance)",
    "Tax incentive"
   ]
  },
  "sector": {
   "type": "string",
   "description": "One to three tags from the fixed list, separated by '; ', or 'All sectors'."
  },
  "status_clean": {
   "enum": [
    "open",
    "opening_soon",
    "rolling",
    "between_rounds",
    "paused",
    "varies",
    "closed",
    "unknown"
   ]
  },
  "closes_date": {
   "type": "string",
   "pattern": "^(\\d{4}-\\d{2}-\\d{2})?$"
  },
  "eligible_sizes": {
   "type": "string",
   "pattern": "^(any|unknown|(micro|small|medium|large)(;(micro|small|medium|large))*)$"
  },
  "before_start_flag": {
   "enum": [
    "yes",
    "no",
    "at_application",
    "not_applicable",
    "unknown"
   ]
  },
  "geo_scope": {
   "enum": [
    "national",
    "regional",
    "eu"
   ]
  }
 }
}